generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model ContactRequest {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  company   String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
}